# bippity — copy to .env.local, fill in what you use. BYO keys only.
# The prototype (apps/web/index.html) needs none of these.

# --- Models (pick at least one; each bot chooses in tools.yaml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# --- Spend safety (executor key should be restricted + capped) ---
BIPPITY_DAILY_SPEND_CAP_USD=25

# --- Computers ---
BIPPITY_COMPUTER_DRIVER=docker        # docker | proxmox | cloud
PROXMOX_HOST=
PROXMOX_API_TOKEN=

# --- Connectors (optional) ---
COMPOSIO_API_KEY=

# --- Bot email / phone (optional, accounts owned by the workspace) ---
AGENTMAIL_API_KEY=
AGENTPHONE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Memory (optional; file memory is the default) ---
HONCHO_API_KEY=

# --- Delivery (v0.3: real sends when shadow mode is OFF) ---
# An approved action delivers via the first configured route:
# webhook (any action) -> SMTP / AgentMail / Composio-Gmail (email) -> Twilio (sms)
BIPPITY_WEBHOOK_URL=                  # e.g. https://hooks.example.com/bippity
BIPPITY_TEST_RECIPIENT=               # default email/SMS recipient for sends
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=                          # 1 = implicit TLS (465-style)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AGENTMAIL_INBOX_ID=                   # inbox id bots send from (AgentMail)
COMPOSIO_CONNECTED_ACCOUNT_ID=        # for Composio Gmail sends
TWILIO_FROM=                          # Twilio sender number (+1...)

# --- Proxmox computers (v0.3 driver; template must run qemu-guest-agent) ---
PROXMOX_HOST=                         # https://your-t480:8006
PROXMOX_API_TOKEN=                    # user@pam!tokenid=uuid-secret
PROXMOX_NODE=pve
PROXMOX_TEMPLATE_VMID=                # template VM bots clone from
PROXMOX_VMID_BASE=9000

# --- Mode ---
BIPPITY_SELF_HOSTED=1
BIPPITY_SHADOW_MODE=1                 # 1 = approved actions are logged, NOT sent. Set 0 to enable real delivery.
BIPPITY_OWNER=                        # channel username allowed to assign work (Slack/Telegram/SMS)

# --- Native Slack / Telegram bots (v0.5) ---
# Slack: create an app at api.slack.com, subscribe to app_mention/message
# events -> Request URL <public URL>/api/slack/events (or the relay URL).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_OWNER_ID=                       # your Slack user id; gates briefs + approvals
# Telegram: bot from @BotFather; set webhook to <public URL>/api/telegram/webhook
# with secret_token equal to TELEGRAM_WEBHOOK_SECRET.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=                    # your Telegram user id; gates briefs + approvals
TELEGRAM_WEBHOOK_SECRET=
BIPPITY_CHANNEL_WORKSPACE=enrollment  # chat briefs target this unless prefixed "<workspace>:"

# --- Hosted relay (v0.5, apps/relay + docs/HOSTED_RELAY.md) ---
# Webhook URL pasted into Slack/Telegram:
#   https://<relay-host>/hook/<slack|telegram>/<workspace>/<RELAY_SECRET>
RELAY_SECRET=
RELAY_PORT=3220
BIPPITY_TARGET_URL=http://127.0.0.1:3211

# --- Hosted tier (v0.6, R2) ---
HOSTED_ADMIN_TOKEN=                   # gates /api/hosted/* (provisioning, usage)
BIPPITY_VAULT_KEY=                    # 32-byte master key (hex or base64) for the tenant secret vault
TENANTS_FILE=                         # relay hosted mode: path to tenants.json
USAGE_FILE=                           # relay hosted mode: path to usage.jsonl (plan caps enforced when set)
RELAY_RATE_PER_MIN=60                 # per-tenant webhook rate limit at the relay

# --- Stripe billing (v0.7, R3) ---
STRIPE_SECRET_KEY=                    # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                # whsec_... for /api/stripe/webhook
STRIPE_PRICE_PRO=                     # price_... for the Pro plan ($20/mo)
STRIPE_PRICE_MAX=                     # price_... for the Max plan ($200/mo)

# --- Public signup site (v0.8) ---
PUBLIC_BASE_URL=                      # e.g. https://hosted.example.com (checkout return URLs)
PUBLIC_RELAY_BASE=                    # public relay base for issued webhook URLs (defaults to PUBLIC_BASE_URL)
SIGNUP_RATE_PER_HOUR=5                # per-IP public signup rate limit
