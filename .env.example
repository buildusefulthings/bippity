# bippity — copy to .env.local, fill in what you use. BYO keys only.
# The prototype (apps/web/index.html) needs none of these.

# --- Models (pick at least one; each bot chooses in tools.yaml) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OLLAMA_HOST=http://127.0.0.1:11434

# --- Spend safety (executor key should be restricted + capped) ---
BIPPITY_DAILY_SPEND_CAP_USD=25

# --- Computers ---
BIPPITY_COMPUTER_DRIVER=docker        # docker | proxmox | cloud
PROXMOX_HOST=
PROXMOX_API_TOKEN=

# --- Connectors (optional) ---
COMPOSIO_API_KEY=

# --- Bot email / phone (optional, accounts owned by the workspace) ---
AGENTMAIL_API_KEY=
AGENTPHONE_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Memory (optional; file memory is the default) ---
HONCHO_API_KEY=

# --- Delivery (v0.3: real sends when shadow mode is OFF) ---
# An approved action delivers via the first configured route:
# webhook (any action) -> SMTP / AgentMail / Composio-Gmail (email) -> Twilio (sms)
BIPPITY_WEBHOOK_URL=                  # e.g. https://hooks.example.com/bippity
BIPPITY_TEST_RECIPIENT=               # default email/SMS recipient for sends
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=                          # 1 = implicit TLS (465-style)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
AGENTMAIL_INBOX_ID=                   # inbox id bots send from (AgentMail)
COMPOSIO_CONNECTED_ACCOUNT_ID=        # for Composio Gmail sends
TWILIO_FROM=                          # Twilio sender number (+1...)

# --- Proxmox computers (v0.3 driver; template must run qemu-guest-agent) ---
PROXMOX_HOST=                         # https://your-t480:8006
PROXMOX_API_TOKEN=                    # user@pam!tokenid=uuid-secret
PROXMOX_NODE=pve
PROXMOX_TEMPLATE_VMID=                # template VM bots clone from
PROXMOX_VMID_BASE=9000

# --- Mode ---
BIPPITY_SELF_HOSTED=1
BIPPITY_SHADOW_MODE=1                 # 1 = approved actions are logged, NOT sent. Set 0 to enable real delivery.
BIPPITY_OWNER=                        # channel username allowed to assign work (Slack/Telegram/SMS)
